 @{
    ViewData["Title"] = "Enquiry Submitted";
}

<section class="success-page">
    <div class="success-card">
        <div class="success-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12.5l4.5 4.5L19 7"></path>
            </svg>
        </div>

        <p class="success-label">ENQUIRY SUBMITTED</p>

        <h1>Thank you!</h1>

        <p class="success-message">
            Your enquiry has been saved successfully.
        </p>

        <p class="success-details">
            Thank you for your interest in our products.
            Our team appreciates your enquiry.
        </p>

        <a asp-controller="Product" asp-action="Index"
           class="success-button">
            CONTINUE BROWSING
            <span aria-hidden="true">→</span>
        </a>

        <p class="success-footer">
            Diagnostics Factory
        </p>
    </div>
</section>

<style>
    .success-page {
        min-height: 65vh;
        padding: 65px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f8fc;
        box-sizing: border-box;
    }

    .success-card {
        width: 100%;
        max-width: 650px;
        box-sizing: border-box;
        padding: 55px 40px 35px;
        background: #fff;
        border: 1px solid #e8eef6;
        border-radius: 12px;
        box-shadow: 0 12px 40px rgba(16, 27, 80, 0.07);
        text-align: center;
    }

    .success-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e7f8f1;
    }

    .success-icon svg {
        width: 38px;
        height: 38px;
        fill: none;
        stroke: #13a879;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .success-label {
        margin: 0 0 12px;
        color: #168fe5;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .success-card h1 {
        margin: 0 0 15px;
        color: #101b50;
        font-size: 42px;
        font-weight: 800;
    }

    .success-message {
        margin: 0 0 12px;
        color: #35445f;
        font-size: 17px;
        line-height: 1.7;
    }

    .success-details {
        max-width: 440px;
        margin: 0 auto 30px;
        color: #8290a5;
        font-size: 14px;
        line-height: 1.9;
    }

    .success-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        padding: 16px 25px;
        border-radius: 4px;
        background: #168fe5;
        color: #fff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.7px;
        transition: background 0.2s ease;
    }

    .success-button:hover {
        background: #1078c4;
        color: #fff;
    }

    .success-button span {
        font-size: 20px;
    }

    .success-footer {
        margin: 35px 0 0;
        padding-top: 20px;
        border-top: 1px solid #edf1f7;
        color: #9aa5b5;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    @@media (max-width: 600px) {
        .success-page {
            padding: 35px 15px;
        }

        .success-card {
            padding: 40px 20px 25px;
        }

        .success-card h1 {
            font-size: 34px;
        }

        .success-button {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>