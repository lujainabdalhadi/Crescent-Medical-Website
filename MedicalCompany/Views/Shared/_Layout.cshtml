    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    
    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const toggle = document.getElementById("searchToggle");
                const box = document.getElementById("siteSearchBox");
                const input = document.getElementById("siteSearchInput");

                if (!toggle || !box || !input) return;

                toggle.addEventListener("click", function(event) {
                    event.preventDefault();

                    const isHidden = box.style.display === "none";
                    box.style.display = isHidden ? "block" : "none";
                    toggle.setAttribute("aria-expanded", isHidden ? "true" : "false");

                    if (isHidden) input.focus();
                });
            });
    </script>
    
<script>
document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.getElementById('enquiryCartToggle');
    const dropdown = document.getElementById('enquiryCartDropdown');
    const itemsContainer = document.getElementById('enquiryCartItems');

    if (!toggle || !dropdown || !itemsContainer) return;

    toggle.addEventListener('click', async function () {
        const isOpen = dropdown.style.display === 'block';
        dropdown.style.display = isOpen ? 'none' : 'block';

        if (isOpen) return;

        itemsContainer.innerHTML = '<p>Loading enquiry items...</p>';

        try {
            const response = await fetch('/Enquiry/Preview');
            if (!response.ok) throw new Error();

            const items = await response.json();

            if (!items.length) {
                itemsContainer.innerHTML = '<p>Your enquiry list is empty.</p>';
                return;
            }

            itemsContainer.innerHTML = items.map(item => `
                <div style="display:flex; gap:18px; align-items:center; margin-bottom:20px;">
                    <img src="${item.imageUrl || ''}" alt=""
                         style="width:100px;height:100px;object-fit:contain;background:#f5f5f5;">
                    <div style="color:#101b50;">
                        <strong>${item.name}</strong>
                        <p style="margin:6px 0;color:#858aa0;font-weight:600;">
                            Cat.No.# ${item.productCode}
                        </p>
                        <strong>Qty: ${item.quantity}</strong>
                    </div>
                </div>
            `).join('');
        } catch {
            itemsContainer.innerHTML =
                '<p>Could not load enquiry items. Open My Enquiry to view them.</p>';
        }
    });

    document.addEventListener('click', function (event) {
        if (!event.target.closest('.enquiry-cart-wrapper')) {
            dropdown.style.display = 'none';
        }
    });
});
</script>
    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const openButton = document.getElementById("cdfMobileMenuOpen");
                const closeButton = document.getElementById("cdfMobileMenuClose");
                const drawer = document.getElementById("cdfMobileDrawer");
                const overlay = document.getElementById("cdfMobileOverlay");

                function openMenu() {
                    drawer.classList.add("open");
                    overlay.classList.add("open");
                    document.body.style.overflow = "hidden";
                }

                function closeMenu() {
                    drawer.classList.remove("open");
                    overlay.classList.remove("open");
                    document.body.style.overflow = "";
                }

                openButton.addEventListener("click", openMenu);
                closeButton.addEventListener("click", closeMenu);
                overlay.addEventListener("click", closeMenu);

                drawer.querySelectorAll("a").forEach(function(link) {
                    link.addEventListener("click", closeMenu);
                });
            });
    </script>
</body>
</html>
