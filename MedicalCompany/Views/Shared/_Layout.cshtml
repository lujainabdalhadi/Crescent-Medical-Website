<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedicalCompany</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/magnific-popup.css" />
    <link rel="stylesheet" href="~/css/jquery-ui.css" />
    <link rel="stylesheet" href="~/css/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/css/owl.theme.default.min.css" />
    <link rel="stylesheet" href="~/css/aos.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <style>
            /* Mobile menu - mobile screens only */
            .cdf-mobile-menu-button {
                display: none;
                border: 0;
                background: transparent;
                color: #173d61;
                font-size: 30px;
                cursor: pointer;
                padding: 5px 10px;
            }

            .cdf-mobile-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.45);
                z-index: 20000;
            }

            .cdf-mobile-drawer {
                position: fixed;
                top: 0;
                right: 0;
                width: min(320px, 85vw);
                height: 100%;
                background: #fff;
                z-index: 20001;
                padding: 25px 22px;
                box-sizing: border-box;
                transform: translateX(100%);
                transition: transform .3s ease;
                overflow-y: auto;
            }

                .cdf-mobile-drawer.open {
                    transform: translateX(0);
                }

            .cdf-mobile-overlay.open {
                display: block;
            }

            .cdf-mobile-drawer a {
                display: block;
                color: #173d61;
                text-decoration: none;
                font-size: 15px;
                font-weight: 600;
                padding: 15px 5px;
                border-bottom: 1px solid #edf1f5;
            }

            .cdf-mobile-drawer .cdf-mobile-submenu a {
                padding: 11px 18px;
                font-size: 13px;
                font-weight: 500;
            }

            .cdf-mobile-close {
                display: block;
                margin-left: auto;
                border: 0;
                background: transparent;
                color: #173d61;
                font-size: 30px;
                cursor: pointer;
            }

            @@media (max-width: 768px) {
                header {
                    height: 70px !important;
                }

                    header > div {
                        height: 70px !important;
                        padding: 0 14px !important;
                    }

                        header > div > a:first-child {
                            width: auto !important;
                            max-width: 75% !important;
                        }

                            header > div > a:first-child img {
                                width: min(210px, 65vw) !important;
                                max-height: 65px !important;
                            }

                .cdf-desktop-nav,
                .cdf-desktop-actions {
                    display: none !important;
                }

                .cdf-mobile-menu-button {
                    display: block !important;
                }

                @@media (max-width: 768px) {
                    .cdf-footer-inner {
                        grid-template-columns: 1fr !important;
                        gap: 28px !important;
                        width: 90% !important;
                    }

                        .cdf-footer-inner > div {
                            min-width: 0 !important;
                            width: 100% !important;
                        }

                    .cdf-footer-description {
                        white-space: normal !important;
                        overflow-wrap: break-word;
                    }

                    .cdf-footer-contact {
                        overflow-wrap: anywhere;
                    }

                    .cdf-footer {
                        overflow-x: hidden;
                    }
                }
            }
    </style>
</head>

