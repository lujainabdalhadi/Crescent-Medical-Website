
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login | Crescent Diagnostics</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #eaf6ff, #ffffff);
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            padding: 42px 35px;
            background: white;
            border: 1px solid #dceaf5;
            border-radius: 22px;
            box-shadow: 0 20px 60px rgba(18, 63, 101, .12);
            animation: appear .6s ease both;
        }

        .logo-mark {
            width: 62px;
            height: 62px;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            color: white;
            background: #218bd0;
            font-size: 28px;
            font-weight: bold;
        }

        h1 {
            margin: 0 0 10px;
            text-align: center;
            color: #123f65;
            font-size: 28px;
        }

        .subtitle {
            margin: 0 0 30px;
            text-align: center;
            color: #71899a;
            line-height: 1.6;
        }

        label {
            display: block;
            margin: 17px 0 8px;
            color: #173d61;
            font-size: 14px;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 14px;
            border: 1px solid #d5e3ee;
            border-radius: 10px;
            outline: none;
            font-size: 15px;
        }

        input:focus {
            border-color: #218bd0;
            box-shadow: 0 0 0 3px rgba(33, 139, 208, .12);
        }

        .password-wrapper {
            position: relative;
            width: 100%;
        }

        .password-wrapper input {
            padding-right: 48px;
        }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 12px;
            transform: translateY(-50%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 5px;
            border: none;
            background: transparent;
            color: #71899a;
            cursor: pointer;
        }

        .toggle-password:hover {
            color: #218bd0;
        }

        .toggle-password svg {
            width: 21px;
            height: 21px;
        }

        .login-button {
            width: 100%;
            margin-top: 25px;
            padding: 15px;
            border: none;
            border-radius: 10px;
            color: white;
            background: #123f65;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background .2s, transform .2s;
        }

        .login-button:hover {
            background: #218bd0;
            transform: translateY(-2px);
        }

        .error-message {
            margin-top: 18px;
            padding: 12px;
            border-radius: 8px;
            color: #a61b1b;
            background: #fff0f0;
            text-align: center;
        }

        .back-link {
            display: block;
            margin-top: 24px;
            text-align: center;
            color: #218bd0;
            text-decoration: none;
            font-size: 14px;
        }

        @@keyframes appear {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>
    <main class="login-card">
        <div class="logo-mark">C</div>

        <h1>Admin Portal</h1>
        <p class="subtitle">
            Crescent Diagnostics Factory<br />
            Sign in to manage your website.
        </p>

        <form asp-controller="Admin"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <label for="username">Username</label>
            <input id="username"
                   name="username"
                   type="text"
                   autocomplete="username"
                   required />

            <label for="password">Password</label>

            <div class="password-wrapper">
                <input id="password"
                       name="password"
                       type="password"
                       autocomplete="current-password"
                       required />

                <button class="toggle-password"
                        type="button"
                        id="togglePassword"
                        aria-label="Show password"
                        aria-pressed="false"
                        title="Show password">

                    <svg id="eyeIcon"
                         xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>

            <button class="login-button" type="submit">
                Sign In →
            </button>

            @if (ViewBag.Error != null)
            {
                <div class="error-message" role="alert">
                    @ViewBag.Error
                </div>
            }
        </form>

        <a class="back-link" href="/">← Back to Website</a>
    </main>

    <script>
        const passwordInput = document.getElementById("password");
        const togglePassword = document.getElementById("togglePassword");
        const eyeIcon = document.getElementById("eyeIcon");

        const eyeOpen = `
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path>
            <circle cx="12" cy="12" r="3"></circle>
        `;

        const eyeClosed = `
            <path d="M3 3l18 18"></path>
            <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
            <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a16 16 0 0 1-3.1 3.9"></path>
            <path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7c1.3 0 2.5-.3 3.5-.8"></path>
        `;

        togglePassword.addEventListener("click", function () {
            const showPassword = passwordInput.type === "password";

            passwordInput.type = showPassword ? "text" : "password";
            eyeIcon.innerHTML = showPassword ? eyeClosed : eyeOpen;

            togglePassword.setAttribute("aria-pressed", showPassword);
            togglePassword.setAttribute(
                "aria-label",
                showPassword ? "Hide password" : "Show password"
            );
            togglePassword.title = showPassword ? "Hide password" : "Show password";
        });
    </script>
</body>
</html>