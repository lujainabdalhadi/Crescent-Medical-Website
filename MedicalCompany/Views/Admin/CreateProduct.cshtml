@model MedicalCompany.Models.Product

@{
    ViewData["Title"] = "Add Product";
    Layout = null;

    var categories = ViewBag.Categories
        as IEnumerable<MedicalCompany.Models.Category>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Add Product | Crescent Diagnostics</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 35px 16px;
                font-family: Arial, sans-serif;
                background: #f2f8fd;
                color: #123f65;
            }

            .form-card {
                max-width: 760px;
                margin: auto;
                padding: 35px;
                background: white;
                border: 1px solid #e0edf7;
                border-radius: 20px;
                box-shadow: 0 15px 45px rgba(18, 63, 101, .08);
            }

            .top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 15px;
                flex-wrap: wrap;
                margin-bottom: 25px;
            }

            h1 {
                margin: 0 0 8px;
                font-size: 30px;
            }

            p {
                color: #71899a;
            }

            a {
                color: #218bd0;
                text-decoration: none;
                font-weight: bold;
            }

            .field {
                margin-bottom: 19px;
            }

            label {
                display: block;
                margin-bottom: 8px;
                font-weight: bold;
            }

            input, select, textarea {
                width: 100%;
                padding: 13px 14px;
                border: 1px solid #d3e2ef;
                border-radius: 10px;
                font: inherit;
                color: #123f65;
                background: white;
            }

                input:focus, select:focus, textarea:focus {
                    outline: 2px solid #b9e1ff;
                    border-color: #218bd0;
                }

                input[type="file"] {
                    background: #f8fbfe;
                }

            .hint {
                font-size: 12px;
                margin-top: 7px;
            }

            .error {
                color: #c62828;
                font-size: 13px;
                display: block;
                margin-top: 6px;
            }

            .actions {
                display: flex;
                gap: 12px;
                margin-top: 25px;
                flex-wrap: wrap;
            }

            button {
                border: 0;
                border-radius: 10px;
                padding: 14px 24px;
                background: #123f65;
                color: white;
                font-weight: bold;
                font-size: 15px;
                cursor: pointer;
            }

                button:hover {
                    background: #218bd0;
                }

            .cancel {
                padding: 14px 20px;
                border: 1px solid #d3e2ef;
                border-radius: 10px;
            }

            @@media (max-width: 500px) {
                .form-card {
                    padding: 22px;
                }
            }
    </style>
</head>

<body>
    <main class="form-card">
        <div class="top">
            <div>
                <h1>Add New Product</h1>
                @if (ViewBag.ErrorMessage != null &&
     !string.IsNullOrWhiteSpace(ViewBag.ErrorMessage.ToString()))
                {
                    <div style="color:#c62828; background:#fff0f0; padding:12px; border-radius:8px; margin:15px 0;">
                        @ViewBag.ErrorMessage
                    </div>
                }
                <p>Enter the product details below.</p>
            </div>

            <a href="/Admin/Products">← Back to Products</a>
        </div>

        <form asp-controller="Admin"
              asp-action="CreateProduct"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="error"></div>

            <div class="field">
                <label asp-for="Name">Product Name</label>
                <input asp-for="Name" placeholder="Enter product name" required />
                <span asp-validation-for="Name" class="error"></span>
            </div>

            <div class="field">
                <label asp-for="ProductCode">Product Code</label>
                <input asp-for="ProductCode" placeholder="e.g. CS600" required />
                <span asp-validation-for="ProductCode" class="error"></span>
            </div>

            <div class="field">
                <label asp-for="Size">Size</label>
                <input asp-for="Size" placeholder="Enter product size" required />
                <span asp-validation-for="Size" class="error"></span>
            </div>

            <div class="field">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId" required>
                    <option value="">Select a category</option>
                    @if (categories != null)
                    {
                        foreach (var category in categories)
                        {
                            <option value="@category.CategoryId">
                                @category.Name
                            </option>
                        }
                    }
                </select>
                <span asp-validation-for="CategoryId" class="error"></span>
            </div>

            <div class="field">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description"
                          rows="4"
                          placeholder="Enter product description"
                          required></textarea>
                <span asp-validation-for="Description" class="error"></span>
            </div>

            <div class="field">
                <label for="imageFile">Product Image</label>
                <input type="file"
                       id="imageFile"
                       name="imageFile"
                       accept=".jpg,.jpeg,.png,.webp" />
                <p class="hint">Allowed formats: JPG, JPEG, PNG, WEBP.</p>
            </div>

            <div class="actions">
                <button type="submit">Save Product →</button>
                <a class="cancel" href="/Admin/Products">Cancel</a>
            </div>
        </form>
    </main>
</body>
</html>
