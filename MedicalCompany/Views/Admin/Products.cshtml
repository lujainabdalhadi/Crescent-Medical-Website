@model List<MedicalCompany.Models.Product>

@{
    ViewData["Title"] = "Manage Products";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Products | Crescent Diagnostics</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f3f8fc;
                color: #123f65;
            }

            .header {
                padding: 28px 5%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                background: white;
                border-bottom: 1px solid #e1edf5;
            }

                .header h1 {
                    margin: 0;
                    font-size: 27px;
                }

                .header a, .back-link {
                    color: #218bd0;
                    text-decoration: none;
                    font-weight: bold;
                }

            .container {
                width: 92%;
                max-width: 1200px;
                margin: 35px auto;
            }

            .intro {
                margin-bottom: 25px;
            }

                .intro p {
                    color: #71899a;
                }

            .table-wrap {
                overflow-x: auto;
                background: white;
                border: 1px solid #e1edf5;
                border-radius: 15px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 650px;
            }

            th, td {
                padding: 17px 20px;
                text-align: left;
                border-bottom: 1px solid #edf2f7;
            }

            th {
                color: #71899a;
                background: #f8fbfe;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: .5px;
            }

            td {
                font-size: 14px;
            }

            tr:last-child td {
                border-bottom: none;
            }

            .product-name {
                font-weight: bold;
            }

            .code {
                display: inline-block;
                padding: 6px 9px;
                background: #edf7ff;
                border-radius: 6px;
                color: #218bd0;
            }

            .count {
                display: inline-block;
                margin-top: 10px;
                padding: 8px 12px;
                border-radius: 8px;
                background: #e7f4ff;
                color: #176aa5;
                font-size: 13px;
            }

            @@media (max-width: 600px) {
                .header {
                    align-items: flex-start;
                    flex-direction: column;
                }

                .container {
                    width: 94%;
                }
            }
    </style>
</head>

<body>
    <header class="header">
        <h1>Manage Products</h1>
        <a href="/Admin/Dashboard">← Back to Dashboard</a>
    </header>

    <main class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="padding:14px 18px; margin-bottom:20px; background:#e8f7ee; color:#207544; border:1px solid #b7e4c7; border-radius:10px;">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="intro">
            <h2>All Products</h2>
            <p>Review the products currently saved in your database.</p>
            <span class="count">Total products: @Model.Count</span>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Product Code</th>
                        <th>Size</th>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="product-name">@product.Name</td>
                            <td><span class="code">@product.ProductCode</span></td>
                            <td>@product.Size</td>
                            <td>@(product.Category?.Name ?? "—")</td>

                            <td style="white-space:nowrap;">
                                <a href="/Admin/EditProduct/@product.ProductId"
                                   style="display:inline-block; padding:8px 14px; background:#218bd0; color:white; border-radius:7px; text-decoration:none; font-weight:bold;">
                                    Edit
                                </a>

                                <form method="post"
                                      action="/Admin/DeleteProduct/@product.ProductId"
                                      style="display:inline-block; margin-left:6px;"
                                      onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@product.ProductId" />
                                    <button type="submit"
                                            style="padding:8px 14px; background:#dc3545; color:white; border:0; border-radius:7px; cursor:pointer; font-weight:bold;">
                                        Delete
                                    </button>
                                </form>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p style="margin-top:25px;">
            <a class="back-link" href="/Product">View Public Products →</a>
        </p>
    </main>
</body>
</html>
