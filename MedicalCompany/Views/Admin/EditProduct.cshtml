@model MedicalCompany.Models.Product
@using MedicalCompany.Models

@{
    ViewData["Title"] = "Edit Product";
    Layout = null;
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Product | Crescent Diagnostics</title>
    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 35px 15px;
                font-family: Arial, sans-serif;
                background: #f3f8fc;
                color: #173d61;
            }

            .container {
                max-width: 750px;
                margin: auto;
                padding: 30px;
                background: white;
                border-radius: 16px;
                box-shadow: 0 8px 25px rgba(18, 63, 101, .08);
            }

            h1 {
                margin-top: 0;
            }

            label {
                display: block;
                margin: 18px 0 7px;
                font-weight: bold;
            }

            input, select, textarea {
                width: 100%;
                padding: 12px;
                border: 1px solid #ccdce8;
                border-radius: 8px;
                font-size: 15px;
            }

            textarea {
                min-height: 110px;
                resize: vertical;
            }

            button, .back {
                display: inline-block;
                margin-top: 22px;
                padding: 12px 20px;
                border: 0;
                border-radius: 8px;
                background: #218bd0;
                color: white;
                text-decoration: none;
                cursor: pointer;
                font-size: 15px;
            }

            .back {
                background: #71899a;
                margin-left: 8px;
            }

            .error {
                color: #c62828;
                margin-top: 12px;
            }

            .current-image {
                max-width: 150px;
                display: block;
                margin-top: 10px;
            }
    </style>
</head>
<body>
    <div class="container">
        <h1>Edit Product</h1>

        <div asp-validation-summary="All" class="error"></div>

        <form asp-controller="Admin"
              asp-action="EditProduct"
              asp-route-id="@Model.ProductId"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />

            <label asp-for="Name">Product Name</label>
            <input asp-for="Name" required />

            <label asp-for="ProductCode">Product Code</label>
            <input asp-for="ProductCode" required />

            <label asp-for="Size">Size</label>
            <input asp-for="Size" required />

            <label asp-for="CategoryId">Category</label>
            <select asp-for="CategoryId" required>
                <option value="">Select a category</option>
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId">
                        @category.Name
                    </option>
                }
            </select>

            <label asp-for="Description">Description</label>
            <textarea asp-for="Description"></textarea>

            <label>Replace Product Image (optional)</label>
            <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" />

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <p>Current image:</p>
                <img src="@Model.ImageUrl" alt="Current product image" class="current-image" />
            }

            <button type="submit">Save Changes</button>
            <a asp-controller="Admin" asp-action="Products" class="back">Cancel</a>
        </form>
    </div>
</body>
</html>
