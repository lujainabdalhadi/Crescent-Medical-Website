@model List<MedicalCompany.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Categories | Crescent Diagnostics</title>
    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f3f8fc;
                color: #123f65;
            }

            .header {
                padding: 28px 5%;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 15px;
                background: white;
                border-bottom: 1px solid #e1edf5;
            }

                .header h1 {
                    margin: 0;
                    font-size: 27px;
                }

            a {
                text-decoration: none;
            }

            .link {
                color: #218bd0;
                font-weight: bold;
            }

            .container {
                width: 92%;
                max-width: 1100px;
                margin: 35px auto;
            }

            .button {
                display: inline-block;
                padding: 11px 16px;
                border-radius: 8px;
                background: #218bd0;
                color: white;
                font-weight: bold;
            }

            .success {
                padding: 14px 18px;
                margin-bottom: 20px;
                background: #e8f7ee;
                color: #207544;
                border: 1px solid #b7e4c7;
                border-radius: 10px;
            }

            .table-wrap {
                overflow-x: auto;
                background: white;
                border: 1px solid #e1edf5;
                border-radius: 15px;
                margin-top: 20px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 500px;
            }

            th, td {
                padding: 17px 20px;
                text-align: left;
                border-bottom: 1px solid #edf2f7;
            }

            th {
                background: #f8fbfe;
                color: #71899a;
                font-size: 12px;
                text-transform: uppercase;
            }

            tr:last-child td {
                border-bottom: none;
            }

            .status {
                color: #207544;
                font-weight: bold;
            }

            .inactive {
                color: #c62828;
                font-weight: bold;
            }
    </style>
</head>
<body>
    <header class="header">
        <h1>Manage Categories</h1>
        <a class="link" href="/Admin/Dashboard">← Back to Dashboard</a>
    </header>

    <main class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            @if (TempData["ErrorMessage"] != null)
            {
                <div style="padding:14px 18px; margin-bottom:20px; background:#fff0f0; color:#c62828; border:1px solid #f5c2c7; border-radius:10px;">
                    @TempData["ErrorMessage"]
                </div>
            }
            <div class="success">@TempData["SuccessMessage"]</div>
        }

        <h2>All Categories</h2>
        <p>Manage the categories used to organize your products.</p>

        <a class="button" href="/Admin/CreateCategory">+ Add New Category</a>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td><strong>@category.Name</strong></td>
                            <td>@category.Description</td>
                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="status">Active</span>
                                }
                                else
                                {
                                    <span class="inactive">Inactive</span>
                                }
                            </td>

                            <td style="white-space:nowrap;">
                                <a href="/Admin/EditCategory/@category.CategoryId"
                                   style="display:inline-block; padding:8px 14px; background:#218bd0; color:white; border-radius:7px; text-decoration:none; font-weight:bold;">
                                    Edit
                                </a>

                                <form method="post"
                                      action="/Admin/DeleteCategory/@category.CategoryId"
                                      style="display:inline-block; margin-left:6px;"
                                      onsubmit="return confirm('Are you sure you want to delete this category?');">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@category.CategoryId" />

                                    <button type="submit"
                                            style="padding:8px 14px; background:#dc3545; color:white; border:0; border-radius:7px; cursor:pointer; font-weight:bold;">
                                        Delete
                                    </button>
                                </form>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>
