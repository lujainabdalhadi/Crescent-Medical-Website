
@{
    ViewData["Title"] = "Contact Us";
}

<style>
    .contact-page {
        --blue: #168bd2;
        --navy: #123f65;
        --muted: #718397;
        --pale: #edf7ff;
        color: var(--navy);
        background: #fff;
        overflow: hidden;
    }

    .contact-page * { box-sizing: border-box; }

    .contact-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: 82px 20px 90px;
        text-align: center;
        background: linear-gradient(120deg, #eaf6ff, #fff 50%, #dcefff);
    }

    .contact-hero::before,
    .contact-hero::after {
        content: "";
        position: absolute;
        z-index: -1;
        border-radius: 50%;
        pointer-events: none;
        animation: contactFloat 9s ease-in-out infinite alternate;
    }

    .contact-hero::before {
        width: 330px;
        height: 330px;
        top: -190px;
        left: -60px;
        border: 1px solid #168bd240;
        box-shadow: 0 0 0 35px #168bd20a,
                    0 0 0 75px #168bd208;
    }

    .contact-hero::after {
        width: 270px;
        height: 270px;
        right: -100px;
        bottom: -180px;
        background: #168bd20c;
        border: 1px solid #168bd230;
        animation-delay: -3s;
    }

    .contact-eyebrow {
        display: inline-block;
        color: var(--blue);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2.5px;
        animation: contactEnter .7s both;
    }

    .contact-hero h1 {
        margin: 19px 0 16px;
        font-size: clamp(42px, 6vw, 68px);
        line-height: 1.08;
        letter-spacing: -2px;
        font-weight: 850;
        animation: contactEnter .8s .1s both;
    }

    .contact-hero h1 span { color: var(--blue); }

    .contact-hero > p {
        max-width: 580px;
        margin: auto;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.9;
        animation: contactEnter .8s .2s both;
    }

    .contact-content {
        width: min(1120px, 90%);
        margin: auto;
        padding: 70px 0;
        display: grid;
        grid-template-columns: .9fr 1.1fr;
        gap: 40px;
        align-items: start;
    }

    .contact-info {
        animation: contactEnter .8s .15s both;
    }

    .contact-info h2,
    .contact-form-card h2 {
        margin: 0 0 12px;
        color: var(--navy);
        font-size: 27px;
        font-weight: 800;
    }

    .contact-info-intro,
    .contact-form-intro {
        margin: 0 0 28px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.9;
    }

    .contact-detail {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 18px;
        padding: 16px;
        border: 1px solid #e7f0f7;
        border-radius: 12px;
        background: #fff;
        transition: transform .3s, border-color .3s,
                    box-shadow .3s;
    }

    .contact-detail:hover {
        transform: translateY(-4px);
        border-color: #b8dff8;
        box-shadow: 0 12px 30px #123f6510;
    }

    .contact-detail-icon {
        width: 45px;
        height: 45px;
        flex: 0 0 45px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: var(--pale);
        color: var(--blue);
        font-size: 21px;
        transition: transform .3s;
    }

    .contact-detail:hover .contact-detail-icon {
        transform: rotate(-6deg) scale(1.06);
    }

    .contact-detail h3 {
        margin: 2px 0 6px;
        color: var(--navy);
        font-size: 13px;
        font-weight: 800;
    }

    .contact-detail p,
    .contact-detail a {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
        overflow-wrap: anywhere;
    }

    .contact-detail a {
        color: var(--blue);
        text-decoration: none;
    }

    .contact-detail a:hover { text-decoration: underline; }

    .contact-form-card {
        position: relative;
        padding: 36px;
        border: 1px solid #e1ebf3;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 18px 55px #123f6510;
        animation: contactEnter .85s .25s both;
    }

    .contact-form-card::before {
        content: "";
        position: absolute;
        top: -1px;
        left: 35px;
        width: 75px;
        height: 3px;
        border-radius: 0 0 5px 5px;
        background: var(--blue);
    }

    .contact-alert {
        margin-bottom: 20px;
        padding: 13px 15px;
        border-radius: 8px;
        font-size: 13px;
        line-height: 1.7;
    }

    .contact-alert.success {
        color: #137653;
        background: #e7f8f1;
        border: 1px solid #b7ebd3;
    }

    .contact-alert.error {
        color: #b42318;
        background: #fff0f0;
        border: 1px solid #ffd0d0;
    }

    .contact-field { margin-bottom: 18px; }

    .contact-field label {
        display: block;
        margin-bottom: 8px;
        color: var(--navy);
        font-size: 12px;
        font-weight: 700;
    }

    .contact-field input,
    .contact-field textarea {
        display: block;
        width: 100%;
        padding: 14px 15px;
        border: 1px solid #d8e4ed;
        border-radius: 8px;
        outline: none;
        background: #fafdff;
        color: var(--navy);
        font: inherit;
        font-size: 13px;
        transition: border-color .25s, box-shadow .25s,
                    background .25s;
    }

    .contact-field input { height: 49px; }

    .contact-field textarea {
        min-height: 135px;
        resize: vertical;
    }

    .contact-field input:focus,
    .contact-field textarea:focus {
        border-color: var(--blue);
        background: #fff;
        box-shadow: 0 0 0 4px #168bd215;
    }

    .contact-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 13px;
        min-height: 50px;
        padding: 0 27px;
        border: 0;
        border-radius: 7px;
        background: var(--blue);
        color: white;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
        cursor: pointer;
        box-shadow: 0 7px 18px #168bd225;
        transition: transform .25s, background .25s,
                    box-shadow .25s;
    }

    .contact-submit:hover {
        transform: translateY(-3px);
        background: var(--navy);
        box-shadow: 0 12px 25px #123f6525;
    }

    .contact-submit span {
        display: inline-block;
        font-size: 18px;
        transition: transform .25s;
    }

    .contact-submit:hover span { transform: translateX(5px); }

    .contact-map-section {
        width: min(1120px, 90%);
        margin: auto;
        padding: 10px 0 75px;
        animation: contactEnter .8s .3s both;
    }

    .contact-map-heading { margin-bottom: 22px; }

    .contact-map-eyebrow {
        color: var(--blue);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .contact-map-heading h2 {
        margin: 10px 0;
        color: var(--navy);
        font-size: 32px;
        font-weight: 800;
    }

    .contact-map-heading p {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.8;
    }

    .contact-map-frame {
        overflow: hidden;
        border: 1px solid #e1ebf3;
        border-radius: 16px;
        box-shadow: 0 15px 40px #123f650d;
        transition: box-shadow .3s;
    }

    .contact-map-frame:hover {
        box-shadow: 0 20px 50px #123f6518;
    }

    .contact-map-frame iframe {
        display: block;
        width: 100%;
        height: 370px;
        border: 0;
    }

    .contact-map-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 18px;
        padding: 13px 21px;
        border-radius: 7px;
        background: var(--pale);
        color: var(--blue);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .6px;
        text-decoration: none;
        transition: background .25s, color .25s,
                    transform .25s;
    }

    .contact-map-link:hover {
        transform: translateY(-2px);
        background: var(--blue);
        color: white;
    }

    .contact-bottom {
        padding: 25px 20px;
        background: var(--pale);
        text-align: center;
    }

    .contact-bottom p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
    }

    .contact-bottom strong { color: var(--navy); }

    @@keyframes contactEnter {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes contactFloat {
        from { transform: translate(0, 0) rotate(0); }
        to { transform: translate(20px, -18px) rotate(8deg); }
    }

    @@media (max-width: 760px) {
        .contact-hero { padding: 60px 20px 65px; }

        .contact-content {
            grid-template-columns: 1fr;
            gap: 30px;
            padding: 42px 0;
        }

        .contact-form-card { padding: 25px; }
        .contact-map-heading h2 { font-size: 27px; }
        .contact-map-frame iframe { height: 300px; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .contact-page *,
        .contact-page *::before,
        .contact-page *::after {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<div class="contact-page">

    <section class="contact-hero">
        <span class="contact-eyebrow">WE ARE HERE TO HELP</span>
        <h1>Let's Talk <span>With Us.</span></h1>
        <p>
            Have a question about our diagnostic products?
            Our team is ready to help you find the information you need.
        </p>
    </section>

    <section class="contact-content">
        <div class="contact-info">
            <h2>Contact Information</h2>
            <p class="contact-info-intro">
                Get in touch with Crescent Diagnostics Factory.
                Our contact details and working hours are listed below.
            </p>

            <div class="contact-detail">
                <div class="contact-detail-icon" aria-hidden="true">⌖</div>
                <div>
                    <h3>Our Address</h3>
                    <p>
                        Crescent Diagnostics Factory<br />
                        Phase-3, Jeddah Industrial City<br />
                        P.O. Box 9939, Jeddah 21423<br />
                        The Kingdom of Saudi Arabia
                    </p>
                </div>
            </div>

            <div class="contact-detail">
                <div class="contact-detail-icon" aria-hidden="true">☎</div>
                <div>
                    <h3>Phone &amp; Fax</h3>
                    <p>
                        <a href="tel:+966126080425">+966 12 6080425</a><br />
                        <a href="tel:+966126081696">+966 12 6081696</a><br />
                        Fax: +966 12 6080420
                    </p>
                </div>
            </div>

            <div class="contact-detail">
                <div class="contact-detail-icon" aria-hidden="true">✉</div>
                <div>
                    <h3>Email Address</h3>
                    <p>
                        <a href="mailto:info@crescentksa.com">
                            info@crescentksa.com
                        </a>
                    </p>
                </div>
            </div>

            <div class="contact-detail">
                <div class="contact-detail-icon" aria-hidden="true">◷</div>
                <div>
                    <h3>Opening Hours</h3>
                    <p>
                        Sunday –Thursday & Saturday<br />
                        8:00 AM – 5:00 PM<br />
                        Friday - Closed
                    </p>
                </div>
            </div>

            <div class="contact-detail">
                <div class="contact-detail-icon" aria-hidden="true">◎</div>
                <div>
                    <h3>Website</h3>
                    <p>
                        <a href="https://www.crescentksa.com"
                           target="_blank"
                           rel="noopener noreferrer">
                            www.crescentksa.com ↗
                        </a>
                    </p>
                </div>
            </div>
        </div>

        <div class="contact-form-card">
            <h2>Send us a Message</h2>
            <p class="contact-form-intro">
                Fill in your details and tell us how we can help.
            </p>

            @if (TempData["ContactSuccess"] != null)
            {
                <div class="contact-alert success" role="status">
                    @TempData["ContactSuccess"]
                </div>
            }

            @if (TempData["ContactError"] != null)
            {
                <div class="contact-alert error" role="alert">
                    @TempData["ContactError"]
                </div>
            }

            <form asp-controller="Home" asp-action="Contact" method="post">
                @Html.AntiForgeryToken()

                <div class="contact-field">
                    <label for="contactName">Your Name *</label>
                    <input id="contactName" type="text" name="Name"
                           placeholder="Enter your full name"
                           autocomplete="name" required />
                </div>

                <div class="contact-field">
                    <label for="contactEmail">Your Email *</label>
                    <input id="contactEmail" type="email" name="Email"
                           placeholder="name@example.com"
                           autocomplete="email" required />
                </div>

                <div class="contact-field">
                    <label for="contactPhone">Your Phone</label>
                    <input id="contactPhone" type="tel" name="Phone"
                           placeholder="Enter your phone number"
                           autocomplete="tel" />
                </div>

                <div class="contact-field">
                    <label for="contactMessage">Your Message *</label>
                    <textarea id="contactMessage" name="Message"
                              placeholder="Write your message here..."
                              required></textarea>
                </div>

                <button type="submit" class="contact-submit">
                    SEND MESSAGE <span aria-hidden="true">→</span>
                </button>
            </form>
        </div>
    </section>

    <section class="contact-map-section">
        <div class="contact-map-heading">
            <span class="contact-map-eyebrow">FIND OUR LOCATION</span>
            <h2>Visit Our Location</h2>
            <p>
                Crescent Diagnostics Factory — Jeddah, Saudi Arabia.
            </p>
        </div>

        <div class="contact-map-frame">
            <iframe
                title="مصنع الهلال للكواشف الطبية على Google Maps"
                src="https://maps.google.com/maps?q=%D9%85%D8%B5%D9%86%D8%B9%20%D8%A7%D9%84%D9%87%D9%84%D8%A7%D9%84%20%D9%84%D9%84%D9%83%D9%88%D8%A7%D8%B4%D9%81%20%D8%A7%D9%84%D8%B7%D8%A8%D9%8A%D8%A9%20%D8%AC%D8%AF%D8%A9&z=16&output=embed"
                loading="lazy"
                allowfullscreen>
            </iframe>
        </div>

     
    </section>

    <div class="contact-bottom">
        <p>
            <strong>We're happy to hear from you.</strong>
            Contact us for product information and assistance.
        </p>
    </div>

</div>
