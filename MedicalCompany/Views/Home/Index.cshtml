<script>
    document.addEventListener("DOMContentLoaded", function() {
        const home = document.querySelector(".cdf-home");
        if (!home) return;

        const sections = home.querySelectorAll(
            ".cdf-about, .cdf-products, .cdf-quality, " +
            ".cdf-accreditations-section, .cdf-global, .cdf-contact"
        );

        if (!("IntersectionObserver" in window)) {
            sections.forEach(section => section.classList.add("cdf-visible"));
            return;
        }

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add("cdf-visible");
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.12
        });

        sections.forEach(section => observer.observe(section));

        // Animated counting for hero statistics
        const counters = home.querySelectorAll(".cdf-hero-stats .cdf-stat strong");

        counters.forEach(function(counter) {
            const originalText = counter.textContent.trim();

            // Keep the founding year fixed
            if (originalText === "1986") return;

            const target = parseInt(originalText.replace(/\D/g, ""), 10);
            if (!Number.isFinite(target)) return;

            const suffix = originalText.includes("+") ? "+" : "";
            const duration = 1600;
            const startTime = performance.now();

            function updateCounter(now) {
                const progress = Math.min((now - startTime) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = Math.floor(target * eased);

                counter.textContent = current + (progress === 1 ? suffix : "");

                if (progress < 1) {
                    requestAnimationFrame(updateCounter);
                }
            }

            counter.textContent = "0";
            requestAnimationFrame(updateCounter);
        });

    });

</script>
