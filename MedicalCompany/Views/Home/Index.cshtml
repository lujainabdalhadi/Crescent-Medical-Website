@{
    ViewData["Title"] = "Home";
}

<style>
    :root {
        --cdf-navy: #123f65;
        --cdf-blue: #218bd0;
        --cdf-light: #edf7ff;
        --cdf-text: #6d8394;
    }

    .cdf-home {
        color: var(--cdf-navy);
        background: #fff;
        overflow: hidden;
    }

        .cdf-home * {
            box-sizing: border-box;
        }

        .cdf-home img {
            max-width: 100%;
        }

        .cdf-home .cdf-label {
            display: inline-block;
            margin-bottom: 14px;
            color: var(--cdf-blue);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .cdf-home .cdf-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 25px;
            border-radius: 30px;
            background: var(--cdf-navy);
            color: white !important;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none !important;
            transition: background .3s, transform .3s, box-shadow .3s;
        }

            .cdf-home .cdf-btn:hover {
                background: var(--cdf-blue);
                transform: translateY(-3px);
                box-shadow: 0 10px 25px #218bd033;
            }

    /* HERO */
    .cdf-hero {
        position: relative;
        min-height: 570px;
        display: flex;
        align-items: center;
        background: #eaf6ff;
        overflow: hidden;
        isolation: isolate;
    }

    .cdf-hero-image {
        position: absolute;
        inset: 0 0 0 auto;
        width: 65%;
        z-index: -1;
        overflow: hidden;
    }

        .cdf-hero-image::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, #eaf6ff 0%, rgba(234,246,255,.92) 15%, rgba(234,246,255,.2) 55%, transparent 75%);
        }

        .cdf-hero-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            animation: cdfHeroZoom 16s ease-in-out infinite alternate;
        }

    .cdf-hero-inner {
        width: min(1200px, 90%);
        margin: auto;
        padding: 70px 0;
    }

    .cdf-hero-content {
        max-width: 650px;
    }

        .cdf-hero-content > * {
            animation: cdfFadeUp .8s both;
        }

            .cdf-hero-content > *:nth-child(1) {
                animation-delay: .1s;
            }

            .cdf-hero-content > *:nth-child(2) {
                animation-delay: .2s;
            }

            .cdf-hero-content > *:nth-child(3) {
                animation-delay: .3s;
            }

            .cdf-hero-content > *:nth-child(4) {
                animation-delay: .4s;
            }

            .cdf-hero-content > *:nth-child(5) {
                animation-delay: .5s;
            }

    .cdf-hero h1 {
        max-width: 680px;
        margin: 0;
        color: var(--cdf-navy);
        font-size: clamp(36px, 4vw, 62px);
        line-height: 1.08;
        font-weight: 850;
        letter-spacing: -1.5px;
    }

        .cdf-hero h1 span,
        .cdf-about h2 span {
            display: block;
            color: #2998e8;
        }

    .cdf-hero-description {
        max-width: 570px;
        margin: 22px 0 28px;
        color: var(--cdf-text);
        font-size: 15px;
        line-height: 1.9;
    }

    .cdf-hero-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 28px;
        margin-top: 35px;
    }

    .cdf-stat {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .cdf-stat-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border: 1px solid #b9def7;
        border-radius: 12px;
        background: #ffffffaa;
        color: var(--cdf-blue);
        font-weight: 800;
    }

    .cdf-stat strong {
        display: block;
        font-size: 20px;
    }

    .cdf-stat small {
        display: block;
        margin-top: 4px;
        color: var(--cdf-text);
        font-size: 11px;
    }

    /* ABOUT */
    .cdf-about {
        padding: 100px 0;
        background: #fff;
    }

    .cdf-about-inner {
        width: min(1200px, 90%);
        margin: auto;
        display: grid;
        grid-template-columns: .9fr 1.1fr;
        align-items: center;
        gap: 65px;
    }

    .cdf-about-image,
    .cdf-quality-image {
        overflow: hidden;
        border-radius: 18px;
        background: var(--cdf-light);
    }

    .cdf-about-image {
        height: 390px;
    }

        .cdf-about-image img,
        .cdf-quality-image img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .7s ease;
        }

        .cdf-about-image:hover img,
        .cdf-quality-image:hover img {
            transform: scale(1.045);
        }

    .cdf-about h2,
    .cdf-quality h2 {
        margin: 0 0 22px;
        color: var(--cdf-navy);
        font-size: clamp(30px, 3vw, 46px);
        line-height: 1.15;
        font-weight: 850;
    }

    .cdf-about p,
    .cdf-quality-text {
        color: var(--cdf-text);
        font-size: 14px;
        line-height: 1.9;
    }

    .cdf-about-points {
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        margin: 25px 0 30px;
    }

        .cdf-about-points strong {
            display: block;
            font-size: 27px;
            color: var(--cdf-navy);
        }

        .cdf-about-points span {
            color: var(--cdf-text);
            font-size: 11px;
        }

    /* PRODUCT RANGE */
    .cdf-products {
        padding: 85px 0 95px;
        background: #fff;
    }

    .cdf-section-inner {
        width: min(1200px, 90%);
        margin: auto;
    }

    .cdf-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 35px;
    }

        .cdf-section-heading h2 {
            margin: 0;
            font-size: clamp(27px, 3vw, 39px);
            line-height: 1.2;
            font-weight: 850;
        }

    .cdf-section-link {
        flex-shrink: 0;
        color: var(--cdf-blue);
        font-size: 12px;
        font-weight: 800;
        text-decoration: none !important;
        transition: transform .25s;
    }

        .cdf-section-link:hover {
            transform: translateX(4px);
        }

    .cdf-product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 22px;
    }

    .cdf-product-card {
        overflow: hidden;
        border: 1px solid #e0edf5;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 28px #123f6509;
        transition: transform .35s ease, box-shadow .35s ease;
    }

        .cdf-product-card:hover {
            transform: translateY(-9px);
            box-shadow: 0 18px 38px #123f6519;
        }

    .cdf-product-image {
        height: 190px;
        overflow: hidden;
        background: var(--cdf-light);
    }

        .cdf-product-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform .6s ease;
        }


    .cdf-product-card:hover .cdf-product-image img {
        transform: scale(1.07);
    }

    .cdf-product-body {
        padding: 22px;
    }

    .cdf-product-number {
        width: 40px;
        height: 40px;
        margin-bottom: 17px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #e7f5ff;
        color: var(--cdf-blue);
        font-size: 12px;
        font-weight: 800;
    }

    .cdf-product-body h3 {
        margin: 0 0 10px;
        font-size: 18px;
        font-weight: 850;
    }

    .cdf-product-body p {
        margin: 0;
        color: var(--cdf-text);
        font-size: 12px;
        line-height: 1.8;
    }

    /* QUALITY */
    .cdf-quality {
        padding: 90px 0;
        background: #eef8ff;
    }

    .cdf-quality-inner {
        width: min(1200px, 90%);
        margin: auto;
        display: grid;
        grid-template-columns: 1.3fr .7fr;
        align-items: center;
        gap: 60px;
    }

    .cdf-quality h2 {
        max-width: 650px;
    }

    .cdf-quality-text {
        margin: 0;
    }

    .cdf-certifications {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-top: 28px;
    }

    .cdf-cert {
        min-height: 105px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid #d4e8f5;
        border-radius: 13px;
        background: white;
        transition: transform .3s, box-shadow .3s;
    }

        .cdf-cert:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px #123f6510;
        }

        .cdf-cert strong {
            font-size: 22px;
            font-weight: 850;
        }

        .cdf-cert span {
            margin-top: 7px;
            color: var(--cdf-text);
            font-size: 10px;
        }

    .cdf-quality-image {
        height: 310px;
    }

    /* ACCREDITATIONS */
    .cdf-accreditations-section {
        padding: 95px 0;
        background: #fff;
    }

    .cdf-certifications-container {
        width: min(1050px, 90%);
        margin: auto;
    }

    .cdf-certifications-header {
        max-width: 750px;
        margin: 0 auto 45px;
        text-align: center;
    }

        .cdf-certifications-header > span {
            color: var(--cdf-blue);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .cdf-certifications-header h2 {
            margin: 18px 0;
            font-size: clamp(30px, 3vw, 45px);
            line-height: 1.15;
            font-weight: 850;
        }

        .cdf-certifications-header p {
            color: var(--cdf-text);
            font-size: 14px;
            line-height: 1.8;
        }

    
    .cdf-certification-cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 25px;
        width: 100%;
    }

        .cdf-certification-cards > .cdf-certification-card:nth-child(3) {
            grid-column: 1 / 3;
            justify-self: center;
            width: 100%;
            max-width: 640px;
        }

    .cdf-certification-card {
        padding: 38px;
        border: 1px solid #dceaf4;
        border-radius: 22px;
        box-shadow: 0 8px 30px #123f6508;
        transition: transform .3s, box-shadow .3s;
    }

        .cdf-certification-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px #123f6512;
        }

    .cdf-certification-icon {
        width: 82px;
        height: 82px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        background: #e8f5ff;
        color: var(--cdf-blue);
        font-size: 28px;
    }

    .cdf-certification-card h3 {
        margin: 25px 0 12px;
        font-size: 23px;
        font-weight: 850;
    }

    .cdf-certification-card p {
        min-height: 48px;
        color: var(--cdf-text);
        font-size: 14px;
        line-height: 1.8;
    }

    .cdf-certification-card a {
        display: inline-block;
        margin-top: 15px;
        color: #07528d;
        font-weight: 800;
        font-size: 13px;
        text-decoration: none;
    }

        .cdf-certification-card a:hover {
            color: var(--cdf-blue);
        }

    /* GLOBAL REACH */
    .cdf-global {
        padding: 85px 0;
        background: #fff;
    }

    .cdf-global-inner {
        width: min(1200px, 90%);
        margin: auto;
        display: grid;
        grid-template-columns: .75fr 1.5fr .5fr;
        align-items: center;
        gap: 35px;
    }

    .cdf-global h2 {
        margin: 0 0 16px;
        font-size: clamp(28px, 3vw, 42px);
        line-height: 1.15;
        font-weight: 850;
    }

    .cdf-global-text {
        color: var(--cdf-text);
        font-size: 14px;
        line-height: 1.8;
    }

    .cdf-map {
        height: 240px;
        overflow: hidden;
        border-radius: 15px;
        background: var(--cdf-light);
    }

        .cdf-map img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform .6s ease;
        }

        .cdf-map:hover img {
            transform: scale(1.04);
        }

    .cdf-region {
        position: relative;
        margin: 16px 0;
        padding-left: 18px;
        color: #405d70;
        font-size: 13px;
    }

        .cdf-region::before {
            content: "";
            position: absolute;
            left: 0;
            top: 6px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--cdf-blue);
        }

    /* CONTACT */
    .cdf-contact {
        padding: 60px 0;
        background: var(--cdf-navy);
    }

    .cdf-contact-inner {
        width: min(1200px, 90%);
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
    }

    .cdf-contact h2 {
        margin: 0 0 12px;
        color: #fff;
        font-size: clamp(25px, 3vw, 36px);
        font-weight: 850;
    }

    .cdf-contact p {
        margin: 0;
        color: #ffffffbb;
        font-size: 14px;
        line-height: 1.8;
    }

    .cdf-contact .cdf-btn {
        flex-shrink: 0;
        background: #7bc3ff;
        color: var(--cdf-navy) !important;
    }

    /* FOOTER */
    .cdf-footer {
        padding: 55px 0 0;
        background: #218bd0;
        color: #fff;
    }

    .cdf-footer-inner {
        width: min(1200px, 90%);
        margin: auto;
        display: grid;
        grid-template-columns: 1.5fr 1fr 1.4fr .8fr;
        gap: 35px;
        padding-bottom: 40px;
    }

    .cdf-footer-logo {
        font-size: 25px;
        font-weight: 800;
        letter-spacing: 3px;
    }

        .cdf-footer-logo span {
            display: block;
            margin-top: 5px;
            font-size: 10px;
            letter-spacing: 2px;
        }

    .cdf-footer-description,
    .cdf-footer-contact {
        color: #ffffffb8;
        font-size: 12px;
        line-height: 1.9;
    }

    .cdf-footer h4 {
        margin: 0 0 20px;
        font-size: 15px;
    }

    .cdf-footer ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .cdf-footer li {
        margin: 12px 0;
    }

    .cdf-footer a {
        color: #ffffffc7;
        font-size: 12px;
        text-decoration: none;
        transition: color .2s;
    }

        .cdf-footer a:hover {
            color: #7bc3ff;
        }

    .cdf-footer-bottom {
        padding: 20px 5%;
        border-top: 1px solid #ffffff20;
        color: #ffffffa6;
        text-align: center;
        font-size: 11px;
    }

    /* ANIMATIONS */
    .cdf-reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity .8s ease, transform .8s ease;
    }

        .cdf-reveal.cdf-visible {
            opacity: 1;
            transform: translateY(0);
        }

        .cdf-reveal .cdf-product-card,
        .cdf-reveal .cdf-certification-card {
            opacity: 0;
            transform: translateY(18px);
            transition: opacity .6s ease, transform .6s ease;
        }

        .cdf-reveal.cdf-visible .cdf-product-card,
        .cdf-reveal.cdf-visible .cdf-certification-card {
            opacity: 1;
            transform: translateY(0);
        }

            .cdf-reveal.cdf-visible .cdf-product-card:nth-child(2),
            .cdf-reveal.cdf-visible .cdf-certification-card:nth-child(2) {
                transition-delay: .12s;
            }

            .cdf-reveal.cdf-visible .cdf-product-card:nth-child(3) {
                transition-delay: .22s;
            }

            .cdf-reveal.cdf-visible .cdf-product-card:nth-child(4) {
                transition-delay: .32s;
            }

    @@keyframes cdfFadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cdfHeroZoom {
        from {
            transform: scale(1);
        }

        to {
            transform: scale(1.07);
        }
    }

    /* RESPONSIVE */
    @@media (max-width: 1000px) {
        .cdf-product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .cdf-about-inner,
        .cdf-quality-inner {
            gap: 35px;
        }

        .cdf-global-inner {
            grid-template-columns: 1fr 1.5fr;
        }

        .cdf-regions {
            grid-column: 1 / -1;
            display: flex;
            flex-wrap: wrap;
            gap: 10px 25px;
        }

        .cdf-region {
            margin: 5px 0;
        }

        .cdf-footer-inner {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .cdf-hero {
            min-height: auto;
        }

        .cdf-hero-image {
            width: 100%;
            opacity: .23;
        }

            .cdf-hero-image::after {
                background: linear-gradient(90deg, #eaf6ffeb, #eaf6ffb8);
            }

        .cdf-hero-inner {
            width: 88%;
            padding: 70px 0;
        }

        .cdf-hero h1 {
            font-size: 39px;
        }

        .cdf-hero-description {
            font-size: 14px;
        }

        .cdf-hero-stats {
            gap: 18px;
        }

        .cdf-about,
        .cdf-products,
        .cdf-quality,
        .cdf-global,
        .cdf-accreditations-section {
            padding: 60px 0;
        }

        .cdf-about-inner,
        .cdf-quality-inner,
        .cdf-global-inner {
            grid-template-columns: 1fr;
        }

        .cdf-about-image {
            height: 270px;
        }

        .cdf-section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .cdf-product-grid,
        .cdf-certification-cards {
            grid-template-columns: 1fr;
        }

        .cdf-certifications {
            gap: 8px;
        }

        .cdf-cert strong {
            font-size: 18px;
        }

        .cdf-quality-image {
            height: 250px;
        }

        .cdf-map {
            height: 200px;
        }

        .cdf-contact-inner {
            align-items: flex-start;
            flex-direction: column;
        }

        .cdf-footer-inner {
            grid-template-columns: 1fr;
        }

        .cdf-certification-card {
            padding: 27px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cdf-home *,
        .cdf-home *::before,
        .cdf-home *::after {
            animation: none !important;
            transition: none !important;
            scroll-behavior: auto !important;
        }

        .cdf-reveal {
            opacity: 1;
            transform: none;
        }

            .cdf-reveal .cdf-product-card,
            .cdf-reveal .cdf-certification-card {
                opacity: 1;
                transform: none;
            }
    }

    /* Animate hero statistics */
    .cdf-hero-stats .cdf-stat {
        opacity: 0;
        animation: cdfStatEnter 0.7s ease forwards;
    }

        .cdf-hero-stats .cdf-stat:nth-child(1) {
            animation-delay: 0.5s;
        }

        .cdf-hero-stats .cdf-stat:nth-child(2) {
            animation-delay: 0.75s;
        }

        .cdf-hero-stats .cdf-stat:nth-child(3) {
            animation-delay: 1s;
        }

    .cdf-hero-stats .cdf-stat-icon {
        animation: cdfIconFloat 3s ease-in-out infinite;
    }

    .cdf-hero-stats .cdf-stat:nth-child(2) .cdf-stat-icon {
        animation-delay: 0.4s;
    }

    .cdf-hero-stats .cdf-stat:nth-child(3) .cdf-stat-icon {
        animation-delay: 0.8s;
    }

    /* Gentle laboratory image movement */
    .cdf-hero-image img {
        animation: cdfHeroMotion 12s ease-in-out infinite alternate;
        transform-origin: center;
    }

    @@keyframes cdfStatEnter {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cdfIconFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    @@keyframes cdfHeroMotion {
        from {
            transform: scale(1);
        }

        to {
            transform: scale(1.06);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cdf-hero-stats .cdf-stat,
        .cdf-hero-stats .cdf-stat-icon,
        .cdf-hero-image img {
            animation: none;
            opacity: 1;
            transform: none;
        }
    }

    /* Continuous counting effect */
    .cdf-hero-stats .cdf-stat strong {
        display: inline-block;
        animation: cdfNumberPulse 1.8s ease-in-out infinite;
    }

    @@keyframes cdfNumberPulse {
        0%, 100% {
            transform: scale(1);
            color: #123f65;
        }

        50% {
            transform: scale(1.12);
            color: #218bd0;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cdf-hero-stats .cdf-stat strong {
            animation: none;
        }
    }

    /* Continuous floating and rotating laboratory image */
    .cdf-hero-image img {
        animation: cdfLabMotion 12s ease-in-out infinite alternate;
        transform-origin: center center;
        will-change: transform;
    }

    @@keyframes cdfLabMotion {
        0% {
            transform: scale(1) rotate(0deg) translateY(0);
        }

        50% {
            transform: scale(1.04) rotate(0.5deg) translateY(-8px);
        }

        100% {
            transform: scale(1.07) rotate(-0.5deg) translateY(5px);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
