
@{
    ViewData["Title"] = "Get in Touch";
}

<style>
    .touch-page {
        --blue: #168bd2;
        --navy: #123f65;
        --muted: #718397;
        background: #f7fbff;
        color: var(--navy);
        overflow: hidden;
    }

    .touch-page * {
        box-sizing: border-box;
    }

    .touch-hero {
        position: relative;
        padding: 85px 20px 100px;
        text-align: center;
        color: white;
        background: linear-gradient(125deg, #123f65, #168bd2);
        overflow: hidden;
    }

    .touch-hero::before,
    .touch-hero::after {
        content: "";
        position: absolute;
        border: 1px solid #ffffff30;
        border-radius: 50%;
        pointer-events: none;
        animation: touchFloat 8s ease-in-out infinite alternate;
    }

    .touch-hero::before {
        width: 320px;
        height: 320px;
        top: -180px;
        left: -60px;
        box-shadow: 0 0 0 35px #ffffff08,
                    0 0 0 75px #ffffff06;
    }

    .touch-hero::after {
        width: 260px;
        height: 260px;
        right: -100px;
        bottom: -170px;
        animation-delay: -3s;
    }

    .touch-eyebrow {
        position: relative;
        display: inline-block;
        margin-bottom: 15px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 3px;
        color: #c9eaff;
    }

    .touch-hero h1 {
        position: relative;
        margin: 0 0 18px;
        font-size: clamp(38px, 6vw, 62px);
        line-height: 1.15;
        font-weight: 850;
        animation: touchEnter .7s both;
    }

    .touch-hero h1 span {
        color: #a9e1ff;
    }

    .touch-hero p {
        position: relative;
        max-width: 580px;
        margin: auto;
        color: #ffffffd9;
        font-size: 15px;
        line-height: 1.9;
        animation: touchEnter .8s .15s both;
    }

    .touch-content {
        position: relative;
        width: min(1080px, 90%);
        margin: -40px auto 0;
        padding-bottom: 80px;
        display: grid;
        grid-template-columns: .8fr 1.2fr;
        gap: 28px;
        align-items: start;
    }

    .touch-info,
    .touch-form-card {
        position: relative;
        padding: 32px;
        border: 1px solid #e5edf5;
        border-radius: 16px;
        background: white;
        box-shadow: 0 16px 45px #123f6510;
        animation: touchEnter .7s .1s both;
    }

    .touch-info h2,
    .touch-form-card h2 {
        margin: 0 0 12px;
        font-size: 25px;
        font-weight: 800;
        color: var(--navy);
    }

    .touch-info > p,
    .touch-form-card > p {
        margin: 0 0 25px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.9;
    }

    .touch-info-item {
        display: flex;
        gap: 13px;
        align-items: flex-start;
        margin-top: 24px;
    }

    .touch-info-icon {
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: #edf7ff;
        color: var(--blue);
        font-size: 20px;
        transition: transform .25s, background .25s;
    }

    .touch-info-item:hover .touch-info-icon {
        transform: translateY(-4px);
        background: #dcefff;
    }

    .touch-info-item h3 {
        margin: 2px 0 6px;
        font-size: 13px;
        font-weight: 800;
    }

    .touch-info-item p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .touch-field {
        margin-bottom: 19px;
    }

    .touch-field label {
        display: block;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 700;
    }

    .touch-field input,
    .touch-field textarea {
        display: block;
        width: 100%;
        padding: 14px 15px;
        border: 1px solid #d8e4ed;
        border-radius: 8px;
        outline: none;
        background: #fbfdff;
        color: var(--navy);
        font: inherit;
        font-size: 13px;
        transition: border-color .25s, box-shadow .25s;
    }

    .touch-field input {
        height: 48px;
    }

    .touch-field textarea {
        min-height: 140px;
        resize: vertical;
    }

    .touch-field input:focus,
    .touch-field textarea:focus {
        border-color: var(--blue);
        background: #fff;
        box-shadow: 0 0 0 4px #168bd215;
    }

    .touch-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 49px;
        padding: 0 26px;
        border: none;
        border-radius: 7px;
        background: var(--blue);
        color: white;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .8px;
        cursor: pointer;
        box-shadow: 0 7px 20px #168bd225;
        transition: transform .25s, background .25s;
    }

    .touch-submit:hover {
        transform: translateY(-3px);
        background: var(--navy);
    }

    .touch-submit span {
        display: inline-block;
        font-size: 18px;
        transition: transform .25s;
    }

    .touch-submit:hover span {
        transform: translateX(5px);
    }

    .touch-alert {
        margin-bottom: 20px;
        padding: 13px 15px;
        border-radius: 8px;
        font-size: 13px;
        line-height: 1.7;
    }

    .touch-alert.success {
        color: #137653;
        background: #e7f8f1;
        border: 1px solid #b7ebd3;
    }

    .touch-alert.error {
        color: #b42318;
        background: #fff0f0;
        border: 1px solid #ffd0d0;
    }

    @@keyframes touchEnter {
        from {
            opacity: 0;
            transform: translateY(22px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes touchFloat {
        from { transform: translate(0, 0); }
        to { transform: translate(18px, -15px); }
    }

    @@media (max-width: 760px) {
        .touch-hero {
            padding: 65px 20px 85px;
        }

        .touch-content {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .touch-info,
        .touch-form-card {
            padding: 25px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .touch-page *,
        .touch-page *::before,
        .touch-page *::after {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<div class="touch-page">
    <section class="touch-hero">
        <span class="touch-eyebrow">LET'S CONNECT</span>
        <h1>Let's Start a <span>Conversation.</span></h1>
        <p>
            Have a question or need more information about our diagnostic
            products? Send us a message and let us know how we can help.
        </p>
    </section>

    <section class="touch-content">
        <div class="touch-info">
            <h2>We're Here for You</h2>
            <p>
                Whether you have a product question or need assistance,
                we'd be happy to hear from you.
            </p>

            <div class="touch-info-item">
                <div class="touch-info-icon" aria-hidden="true">✉</div>
                <div>
                    <h3>Email Us</h3>
                    <p>info@crescentksa.com</p>
                </div>
            </div>

            <div class="touch-info-item">
                <div class="touch-info-icon" aria-hidden="true">☎</div>
                <div>
                    <h3>Call Our Team</h3>
                    <p>+966 12 6080425</p>
                    <p>+966 12 6081696</p>
                </div>
            </div>

            <div class="touch-info-item">
                <div class="touch-info-icon" aria-hidden="true">◷</div>
                <div>
                    <h3>Business Hours</h3>
                    <p>Sunday – Thursday</p>
                    <p>9:00 AM – 5:00 PM</p>
                </div>
            </div>
        </div>

        <div class="touch-form-card">
            <h2>Send Us a Message</h2>
            <p>
                Fill in the form and we'll have your message recorded.
            </p>

            @if (TempData["ContactSuccess"] != null)
            {
                <div class="touch-alert success" role="status">
                    @TempData["ContactSuccess"]
                </div>
            }

            @if (TempData["ContactError"] != null)
            {
                <div class="touch-alert error" role="alert">
                    @TempData["ContactError"]
                </div>
            }

            <form asp-controller="Home" asp-action="Contact" method="post">
                @Html.AntiForgeryToken()

                <div class="touch-field">
                    <label for="touchName">Your Name *</label>
                    <input id="touchName"
                           name="Name"
                           type="text"
                           placeholder="Enter your full name"
                           autocomplete="name"
                           required />
                </div>

                <div class="touch-field">
                    <label for="touchEmail">Your Email *</label>
                    <input id="touchEmail"
                           name="Email"
                           type="email"
                           placeholder="name@example.com"
                           autocomplete="email"
                           required />
                </div>

                <div class="touch-field">
                    <label for="touchPhone">Your Phone</label>
                    <input id="touchPhone"
                           name="Phone"
                           type="tel"
                           placeholder="Enter your phone number"
                           autocomplete="tel" />
                </div>

                <div class="touch-field">
                    <label for="touchMessage">Your Message *</label>
                    <textarea id="touchMessage"
                              name="Message"
                              placeholder="How can we help you?"
                              required></textarea>
                </div>

                <button class="touch-submit" type="submit">
                    SEND MESSAGE <span aria-hidden="true">→</span>
                </button>
            </form>
        </div>
    </section>
</div>
